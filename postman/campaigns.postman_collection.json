        {
          "name": "Bounded retries -> exactly max-attempts provider calls",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('200 OK', () => pm.expect(pm.response.code).to.eql(200));",
                  "const r = b.recipients.find(x => x.email === 'always-fail@example.com');",
                  "if (r.status === 'FAILED') {",
                  "    pm.test('retries stopped at the limit (5 attempts)', () => pm.expect(r.providerCalls).to.eql(5));",
