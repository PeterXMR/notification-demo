        {
          "name": "Temporary error -> eventually sent, 3 provider calls",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('200 OK', () => pm.expect(pm.response.code).to.eql(200));",
                  "const r = b.recipients.find(x => x.email === 'temp-fail@example.com');",
                  "if (r.status === 'SENT') {",
                  "    pm.test('retried: 3 provider calls', () => pm.expect(r.providerCalls).to.eql(3));",
                  "    pm.test('delivered exactly once despite retries', () => pm.expect(r.delivered).to.eql(1));",
                  "} else {",
                  "    console.log(`still ${r.status} after ${r.providerCalls} call(s) — retry backoff in progress, send again`);",
                  "}"
                ],
                "type": "text/javascript"
              }
