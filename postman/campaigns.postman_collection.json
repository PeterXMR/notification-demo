        {
          "name": "Get campaign status (poll until COMPLETED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "console.log(`${b.status}: sent=${b.sent} failed=${b.failed} remaining=${b.remaining} (total=${b.total})`);",
                  "pm.test('200 OK', () => pm.expect(pm.response.code).to.eql(200));",
                  "pm.test('counts are consistent', () => pm.expect(b.sent + b.failed + b.remaining).to.eql(b.total));",
                  "pm.test('status matches remaining', () => pm.expect(b.status).to.eql(b.remaining > 0 ? 'PROCESSING' : 'COMPLETED'));",
                  "if (b.status === 'PROCESSING' && typeof pm.execution !== 'undefined' && pm.execution.setNextRequest) {",
                  "    pm.execution.setNextRequest('Get campaign status (poll until COMPLETED)');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/campaigns/{{campaignId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "campaigns",
                "{{campaignId}}"
              ]
            },
            "description": "Repeat manually (or let the Collection Runner loop) to watch PROCESSING -> COMPLETED with growing counts. Expected end state: failed=1 (bounce@), everyone else sent."
          }
        }
      ]
