                  "pm.collectionVariables.set('dedupCampaignId', body.campaignId);",
                  "pm.test('202 Accepted', () => pm.expect(pm.response.code).to.eql(202));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/campaigns",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "campaigns"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"Dedup scenario\",\n  \"message\": \"The same mailbox listed three times must get ONE email.\",\n  \"recipients\": [\n    \"bob@example.com\",\n    \"BOB@example.com\",\n    \"Bob@Example.com\"\n  ]\n}"
            },
            "description": "Case-insensitive silent deduplication: total=1, and the deliveries endpoint proves a single physical delivery."
          }
        },
        {
          "name": "Duplicate addresses -> total=1, delivered once",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('200 OK', () => pm.expect(pm.response.code).to.eql(200));",
                  "pm.test('one recipient row', () => pm.expect(b.recipients.length).to.eql(1));",
                  "const r = b.recipients[0];",
                  "if (r.status === 'SENT') {",
                  "    pm.test('delivered exactly once', () => pm.expect(r.delivered).to.eql(1));",
                  "    pm.test('no suppressed duplicates needed', () => pm.expect(r.duplicatesSuppressed).to.eql(0));",
                  "} else { console.log('still processing — send again in a moment'); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/campaigns/{{dedupCampaignId}}/deliveries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "campaigns",
                "{{dedupCampaignId}}",
                "deliveries"
              ]
            }
          }
        },
        {
          "name": "Bulk campaign -> nobody delivered more than once",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('200 OK', () => pm.expect(pm.response.code).to.eql(200));",
                  "pm.test('no recipient delivered more than once', () =>",
                  "    b.recipients.forEach(r => pm.expect(r.delivered, r.email).to.be.at.most(1)));",
                  "pm.test('every SENT recipient delivered exactly once', () =>",
                  "    b.recipients.filter(r => r.status === 'SENT').forEach(r => pm.expect(r.delivered, r.email).to.eql(1)));",
                  "const retried = b.recipients.filter(r => r.providerCalls > 1);",
                  "console.log(`retried recipients: ${retried.map(r => `${r.email} (${r.providerCalls} calls, ${r.delivered} delivered)`).join(', ') || 'none yet'}`);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/campaigns/{{campaignId}}/deliveries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "campaigns",
                "{{campaignId}}",
                "deliveries"
              ]
            },
            "description": "THE acceptance criterion: run against the folder-1 campaign (any campaign id in {{campaignId}}). Even recipients the application retried several times show delivered=1 — internal retries never re-send an already delivered notification."
          }
