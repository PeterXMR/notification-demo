        {
          "name": "Permanent rejection -> failed=1, exactly 1 attempt",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('200 OK', () => pm.expect(pm.response.code).to.eql(200));",
                  "const bounce = b.recipients.find(x => x.email === 'bounce@example.com');",
                  "const john = b.recipients.find(x => x.email === 'john@example.com');",
                  "if (bounce.status === 'FAILED' && john.status === 'SENT') {",
                  "    pm.test('no endless retrying: exactly 1 provider call', () => pm.expect(bounce.providerCalls).to.eql(1));",
                  "    pm.test('never delivered', () => pm.expect(bounce.delivered).to.eql(0));",
                  "    pm.test('failure did not stop the other recipient', () => pm.expect(john.delivered).to.eql(1));",
                  "} else {",
                  "    console.log('still processing — send again in a moment');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
